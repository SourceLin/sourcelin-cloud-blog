DATA_ROOT=/home/sourcelin/deploy/data
JAR_ROOT=/home/sourcelin/deploy/jars
LOG_ROOT=/home/sourcelin/deploy/logs

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace-with-your-mysql-password
NACOS_DB_NAME=sourcelin-config

NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_GROUP=BLOG_GROUP
NACOS_USERNAME=replace-with-your-nacos-username
NACOS_PASSWORD=replace-with-your-nacos-password

NACOS_AUTH_TOKEN=replace-with-a-strong-base64-token
NACOS_AUTH_IDENTITY_KEY=replace-with-a-random-identity-key
NACOS_AUTH_IDENTITY_VALUE=replace-with-a-random-identity-value

# 认证、网关、业务服务和消息服务共用同一 Redis 实例与库编号。
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# Java 服务使用的业务库连接。
DB_URL=jdbc:mysql://127.0.0.1:3306/sourcelin-cloud?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=replace-with-your-business-db-username
DB_PASSWORD=replace-with-your-business-db-password

# 可选服务：AI 能力服务（端口 9205）
# 需将 sourcelin-modules-ai.jar 放入 JAR_ROOT 目录
# AI 表和默认能力由 docs/sql/sourcelin-cloud.sql 一次性初始化。

# 可选服务：消息推送服务（端口 9400）
# 需将 sourcelin-modules-message.jar 放入 JAR_ROOT 目录

# AI 服务端 API 密钥加密用的部署密钥：Base64 编码的随机 32 字节值。
AI_CONFIG_ENCRYPTION_KEY=
# AI 服务可用 Nacos 数据源配置，也可从环境变量读取业务库连接。
# AI_DB_URL=
# AI_DB_USERNAME=
# AI_DB_PASSWORD=
# 可选能力默认关闭。消息开关同时用于博客和系统服务。
BLOG_AI_ENABLED=false
BLOG_MESSAGE_ENABLED=false
# 文件服务远程图片来源允许列表，未配置则拒绝远程下载。
FILE_REMOTE_ALLOWED_HOSTS=
