<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sourcelin.ai.mapper.AiTaskMapper">

    <resultMap type="com.sourcelin.ai.domain.AiTask" id="AiTaskResult">
        <result property="id" column="id" />
        <result property="taskId" column="task_id" />
        <result property="requestId" column="request_id" />
        <result property="appCode" column="app_code" />
        <result property="domainCode" column="domain_code" />
        <result property="abilityCode" column="ability_code" />
        <result property="bizId" column="biz_id" />
        <result property="userId" column="user_id" />
        <result property="tenantId" column="tenant_id" />
        <result property="status" column="status" />
        <result property="progress" column="progress" />
        <result property="inputSnapshot" column="input_snapshot" />
        <result property="resultSnapshot" column="result_snapshot" />
        <result property="errorMessage" column="error_message" />
        <result property="retryCount" column="retry_count" />
        <result property="callbackUrl" column="callback_url" />
        <result property="startedTime" column="started_time" />
        <result property="finishedTime" column="finished_time" />
        <result property="createTime" column="create_time" />
        <result property="updateTime" column="update_time" />
    </resultMap>

    <sql id="selectAiTaskVo">
        select id, task_id, request_id, app_code, domain_code, ability_code, biz_id, user_id, tenant_id,
               status, progress, input_snapshot, result_snapshot, error_message, retry_count, callback_url,
               started_time, finished_time, create_time, update_time
        from ai_task
    </sql>

    <select id="selectByTaskId" parameterType="String" resultMap="AiTaskResult">
        <include refid="selectAiTaskVo"/>
        where task_id = #{taskId}
    </select>

    <select id="selectList" parameterType="com.sourcelin.ai.domain.AiTask" resultMap="AiTaskResult">
        <include refid="selectAiTaskVo"/>
        <where>
            <if test="taskId != null and taskId != ''"> and task_id = #{taskId}</if>
            <if test="requestId != null and requestId != ''"> and request_id = #{requestId}</if>
            <if test="abilityCode != null and abilityCode != ''"> and ability_code = #{abilityCode}</if>
            <if test="bizId != null and bizId != ''"> and biz_id = #{bizId}</if>
            <if test="status != null and status != ''"> and status = #{status}</if>
        </where>
        order by create_time desc
    </select>

    <insert id="insert" parameterType="com.sourcelin.ai.domain.AiTask" useGeneratedKeys="true" keyProperty="id">
        insert into ai_task (
            task_id,
            request_id,
            <if test="appCode != null and appCode != ''">app_code,</if>
            <if test="domainCode != null and domainCode != ''">domain_code,</if>
            ability_code,
            biz_id,
            user_id,
            <if test="tenantId != null and tenantId != ''">tenant_id,</if>
            status,
            progress,
            <if test="inputSnapshot != null and inputSnapshot != ''">input_snapshot,</if>
            <if test="resultSnapshot != null and resultSnapshot != ''">result_snapshot,</if>
            <if test="errorMessage != null and errorMessage != ''">error_message,</if>
            <if test="retryCount != null">retry_count,</if>
            <if test="callbackUrl != null and callbackUrl != ''">callback_url,</if>
            <if test="startedTime != null">started_time,</if>
            <if test="finishedTime != null">finished_time,</if>
            create_time, update_time
        ) values (
            #{taskId},
            #{requestId},
            <if test="appCode != null and appCode != ''">#{appCode},</if>
            <if test="domainCode != null and domainCode != ''">#{domainCode},</if>
            #{abilityCode},
            #{bizId},
            #{userId},
            <if test="tenantId != null and tenantId != ''">#{tenantId},</if>
            #{status},
            #{progress},
            <if test="inputSnapshot != null and inputSnapshot != ''">#{inputSnapshot},</if>
            <if test="resultSnapshot != null and resultSnapshot != ''">#{resultSnapshot},</if>
            <if test="errorMessage != null and errorMessage != ''">#{errorMessage},</if>
            <if test="retryCount != null">#{retryCount},</if>
            <if test="callbackUrl != null and callbackUrl != ''">#{callbackUrl},</if>
            <if test="startedTime != null">#{startedTime},</if>
            <if test="finishedTime != null">#{finishedTime},</if>
            sysdate(), sysdate()
        )
    </insert>

    <update id="updateByTaskId" parameterType="com.sourcelin.ai.domain.AiTask">
        update ai_task
        <set>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="progress != null">progress = #{progress},</if>
            <if test="resultSnapshot != null and resultSnapshot != ''">result_snapshot = #{resultSnapshot},</if>
            <if test="errorMessage != null and errorMessage != ''">error_message = #{errorMessage},</if>
            <if test="startedTime != null">started_time = #{startedTime},</if>
            <if test="finishedTime != null">finished_time = #{finishedTime},</if>
            update_time = sysdate()
        </set>
        where task_id = #{taskId}
    </update>
    <update id="resetFailedTask">
        UPDATE ai_task
        SET status = 'pending', progress = 0, error_message = NULL, result_snapshot = NULL,
            started_time = NULL, finished_time = NULL, retry_count = COALESCE(retry_count, 0) + 1,
            update_time = NOW()
        WHERE task_id = #{taskId} AND status = 'failed' AND COALESCE(retry_count, 0) = #{retryCount}
    </update>

</mapper>
