{
  "name": "sourcelin-ui-admin",
  "description": "圆圈博客 管理后台（Vue3 + Vite + TypeScript + Element Plus）",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build --base=/admin/",
    "preview": "vite preview",
    "build-only": "vite build --base=/admin/",
    "type-check": "vue-tsc --noEmit",
    "lint:eslint": "eslint --cache \"src/**/*.{vue,ts,js}\" --fix",
    "lint:prettier": "prettier --write \"**/*.{js,cjs,ts,json,css,scss,vue,html,md}\"",
    "lint:stylelint": "stylelint --cache \"**/*.{css,scss,vue}\" --fix",
    "lint:lint-staged": "lint-staged",
    "lint": "npm run lint:eslint && npm run lint:prettier && npm run lint:stylelint",
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "commit": "git-cz"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{cjs,json}": [
      "prettier --write"
    ],
    "*.{vue,html}": [
      "eslint --fix",
      "prettier --write",
      "stylelint --fix"
    ],
    "*.{scss,css}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@vueuse/core": "^15.1.0",
    "@vxe-ui/core": "^4.5.10",
    "@wangeditor-next/editor": "^6.7.0",
    "@wangeditor-next/editor-for-vue": "^6.7.0",
    "animate.css": "^4.1.1",
    "axios": "^1.21.1",
    "codemirror": "^5.65.21",
    "codemirror-editor-vue3": "^2.8.0",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.8",
    "exceljs": "^4.4.0",
    "jsencrypt": "^3.5.4",
    "lodash-es": "^4.18.1",
    "nprogress": "^0.2.0",
    "path-browserify": "^1.0.1",
    "path-to-regexp": "^9.0.0",
    "pinia": "^4.1.0",
    "qs": "^6.17.1",
    "sortablejs": "^1.15.7",
    "vue": "^3.5.46",
    "vue-draggable-plus": "^0.6.1",
    "vue-i18n": "^11.4.23",
    "vue-router": "^5.5.1",
    "vxe-pc-ui": "^4.21.7",
    "vxe-table": "~4.24.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@iconify/utils": "^3.1.7",
    "@types/codemirror": "^5.60.18",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.10",
    "@types/nprogress": "^0.2.3",
    "@types/path-browserify": "^1.0.3",
    "@types/qs": "^6.15.1",
    "@types/sortablejs": "^1.15.9",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "autoprefixer": "^10.7.0",
    "commitizen": "^4.3.2",
    "cz-git": "^1.14.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "postcss": "^8.5.33",
    "postcss-html": "^2.0.1",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.10.1",
    "sass": "^1.108.2",
    "stylelint": "^18.1.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-recess-order": "^7.10.1",
    "stylelint-config-recommended": "^19.1.0",
    "stylelint-config-recommended-scss": "^18.0.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-prettier": "^5.1.0",
    "terser": "^5.51.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "unocss": "^66.13.0",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.8",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.2.9"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "repository": "https://github.com/sourcelin/sourcelin-cloud-blog.git",
  "author": "Sourcelin Team",
  "license": "MIT"
}
