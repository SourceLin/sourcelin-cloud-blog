{
  "name": "sourcelin-ui-uniapp",
  "version": "0.1.0",
  "description": "Sourcelin Blog Uniapp 客户端（微信小程序 + H5），Vue3 + TypeScript + Vite",
  "private": true,
  "scripts": {
    "dev:mp-weixin": "node build-tools/with-local-wechat-appid.mjs -- uni -p mp-weixin",
    "dev:h5": "uni",
    "dev:app": "uni -p app",
    "build:mp-weixin": "node build-tools/with-local-wechat-appid.mjs -- uni build -p mp-weixin",
    "build:h5": "uni build",
    "build:app": "uni build -p app",
    "type-check": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5030420261029002",
    "@dcloudio/uni-app-harmony": "3.0.0-5030420261029002",
    "@dcloudio/uni-app-plus": "3.0.0-5030420261029002",
    "@dcloudio/uni-components": "3.0.0-5030420261029002",
    "@dcloudio/uni-h5": "3.0.0-5030420261029002",
    "@dcloudio/uni-mp-weixin": "3.0.0-5030420261029002",
    "@dcloudio/uni-ui": "^1.5.12",
    "jsencrypt": "^3.5.4",
    "pinia": "^4.1.0",
    "vue": "^3.5.46",
    "vue-i18n": "^11.4.23"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/uni-automator": "3.0.0-5030420261029002",
    "@dcloudio/uni-cli-shared": "3.0.0-5030420261029002",
    "@dcloudio/uni-stacktracey": "3.0.0-5030420261029002",
    "@dcloudio/vite-plugin-uni": "3.0.0-5030420261029002",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.10",
    "@vue/runtime-core": "^3.5.46",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "sass": "^1.108.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "5.2.8",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "3.2.9"
  },
  "engines": {
    "node": ">=18"
  }
}
