{
  "name": "sourcelin-ui-platform-v3",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc -b",
    "lint:eslint": "eslint src --max-warnings 0",
    "lint": "npm run lint:eslint && npm run style:guard",
    "layering:guard": "node scripts/layering-guard.mjs",
    "preview": "vite preview",
    "test:architecture": "node --experimental-strip-types scripts/architecture-refactor.test.mjs && node scripts/layering-guard.mjs",
    "test:layering-guard": "node --test scripts/layering-guard.test.mjs",
    "test:style-guard": "node --test scripts/style-guard.test.mjs",
    "style:guard": "node scripts/style-guard.mjs"
  },
  "dependencies": {
    "@unhead/vue": "^3.5.2",
    "@vicons/ionicons5": "^0.13.0",
    "@vueup/vue-quill": "^1.5.5",
    "@vueuse/core": "^15.1.0",
    "@zxzinn/vue-waterfall": "^0.3.0",
    "axios": "^1.21.1",
    "echarts": "^6.1.0",
    "fuse.js": "^7.5.0",
    "highlight.js": "^11.12.0",
    "js-cookie": "^3.0.8",
    "jsencrypt": "^3.5.4",
    "lodash-es": "^4.18.1",
    "naive-ui": "^2.45.3",
    "nprogress": "^0.2.0",
    "pinia": "^4.1.0",
    "sass": "^1.108.2",
    "screenfull": "^6.0.2",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vue": "^3.5.46",
    "vue-echarts": "^8.3.2",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.10",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "3.2.9"
  }
}
